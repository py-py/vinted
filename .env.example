# Vinted user ID whose favourites are fetched
VINTED_USER_ID=

# Telegram bot credentials used to deliver notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Gemini API key (read by google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GCP / Firestore (used by vinted.orders --save)
GOOGLE_CLOUD_PROJECT=vinted-492007
FIRESTORE_DATABASE=vinted-dev