# Vinted user ID whose favourites are fetched
VINTED_USER_ID=

# Telegram bot credentials used to deliver notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Gemini API key (read by google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek, via pydantic-ai: suggests listing title/description from photos (vinted.listing)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# GCP / Firestore / GCS (used by vinted.account.purchases)
GOOGLE_CLOUD_PROJECT=vinted-492007
FIRESTORE_DATABASE=vinted-dev
VINTED_GCS_BUCKET=vinted-dev

# HTTP Basic auth for the admin web app (vinted.admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=