# --- Vinted ---
# User ID whose favourites are fetched
VINTED_USER_ID=
VINTED_LOCALE=pl

# --- Telegram ---
# Bot credentials used to deliver notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM provider: gemini | claude ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Database ---
# SQLAlchemy async URL. Inside docker-compose the vinted service overrides this
# to host "db". For host-run tools (alembic, uvicorn) Postgres is on localhost:5433.
DATABASE_URL=postgresql+asyncpg://vinted:vinted@localhost:5433/vinted

# --- GCP ---
GCP_PROJECT=
# Path to a service-account key for Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Cloud Storage (product images) ---
GCS_BUCKET=

# --- Notification policy ---
# Only notify when recommendation is in the allowed set AND rating >= min
NOTIFY_MIN_RATING=4
