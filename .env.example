# Telegram bot credentials used to deliver notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Gemini API key (google-genai SDK in vinted.analyzer; pydantic-ai in vinted.listing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek, via pydantic-ai in vinted.listing (when LISTING_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# LLM for listing title/description from photos (vinted.listing): google or deepseek.
# Uses that provider's *_API_KEY and *_MODEL above.
LISTING_PROVIDER=google

# GCP / Firestore / GCS (used by vinted.account.purchases)
GOOGLE_CLOUD_PROJECT=vinted-492007
FIRESTORE_DATABASE=vinted-dev
VINTED_GCS_BUCKET=vinted-dev

# HTTP Basic auth for the admin web app (vinted.admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=