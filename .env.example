# Vinted user ID whose favourites are fetched
VINTED_USER_ID=

# Telegram bot credentials used to deliver notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Gemini API key (read by google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Notifier store: 'firestore' (default) or 'json' (local file)
NOTIFIER_STORE=firestore
# Google Cloud project + Firestore database for the notifier
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=