{
  "manifest_version": 3,
  "name": "Vinted Favourite Colorizer",
  "version": "1.0.0",
  "description": "Highlights Vinted item cards based on the number of favourites",
  "content_scripts": [
    {
      "matches": ["*://*.vinted.pl/*", "*://*.vinted.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
